{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "outputDirectory": "dist",
  "cleanUrls": true,
  "trailingSlash": true,
  "redirects": [
    {
      "source": "/jabez",
      "destination": "/link/?utm_source=instagram&utm_medium=bio&utm_campaign=jabez",
      "permanent": false
    },
    {
      "source": "/jabez/",
      "destination": "/link/?utm_source=instagram&utm_medium=bio&utm_campaign=jabez",
      "permanent": false
    },
    {
      "source": "/boop",
      "destination": "/link/?utm_source=instagram&utm_medium=bio&utm_campaign=boop",
      "permanent": false
    },
    {
      "source": "/boop/",
      "destination": "/link/?utm_source=instagram&utm_medium=bio&utm_campaign=boop",
      "permanent": false
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self'; script-src 'self' 'sha256-Irv4YFk//hOjDnuYb+RIfCi6EbKKL+4E+92ctwZTTJk='; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self'; connect-src 'self' https://zqugfixszhfoochvaaol.supabase.co; frame-src https://www.instagram.com; object-src 'none'; base-uri 'self'; form-action 'none'; frame-ancestors 'self'; upgrade-insecure-requests"
        },
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=(), payment=(), usb=()"
        }
      ]
    },
    {
      "source": "/404",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, follow"
        }
      ]
    },
    {
      "source": "/(.*)",
      "has": [
        {
          "type": "host",
          "value": {
            "suf": ".vercel.app"
          }
        }
      ],
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex"
        }
      ]
    }
  ]
}
